---
import Base from '../layouts/Base.astro';
import site from '../site';

const { title, lede, links } = site.contact;
---

<Base title={title} section={title} description={lede}>
  <header class="art-head">
    <h1>{title}</h1>
  </header>

  {lede && <p class="lede" set:html={lede} />}

  {
    links.length === 0 ? (
      <div class="empty">{site.ui.noContact}</div>
    ) : (
      <ul class="contact-list">
        {links.map((l) => (
          <li>
            <span class="k">{l.label}</span>
            <span>
              <a href={l.url}>{l.text}</a>
            </span>
          </li>
        ))}
      </ul>
    )
  }
</Base>
